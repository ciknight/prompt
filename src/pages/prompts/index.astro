---
// src/pages/prompts/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PromptCard from '../../components/PromptCard.astro';

// Strip markdown syntax so the excerpt on listing cards reads as plain
// prose instead of leaking `## headings`, `![image](url)`, `[link](url)`
// into the listing page. Keeps Chinese text, punctuation, and whitespace.
function plainExcerpt(md) {
  return md
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/^[ \t]*(#{1,6}|>|\*|-|\d+\.)[ \t]+/gm, '')
    .replace(/[*_`]+/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

const prompts = await getCollection('prompts');
const sorted = prompts.sort((a, b) =>
  (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0)
);
---
<BaseLayout title="全部 Prompts · AI 提示词收藏">
  <h1>全部 Prompts</h1>
  <p>{sorted.length} 个</p>
  {sorted.map(p => (
    <PromptCard
      title={p.data.title}
      category={p.data.category}
      tags={p.data.tags}
      slug={p.data.slug}
      excerpt={plainExcerpt(p.body ?? '').slice(0, 120)}
      date={p.data.date}
    />
  ))}
</BaseLayout>