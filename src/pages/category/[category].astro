---
// src/pages/category/[category].astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PromptCard from '../../components/PromptCard.astro';
import { CATEGORIES, categoryFromSlug } from '../../../scripts/lib/category-map.mjs';

export async function getStaticPaths() {
  return CATEGORIES.map(name => ({
    params: { category: name === '剧本分镜' ? 'juben-fenjing'
                          : name === '角色与IP' ? 'juese-yu-ip'
                          : name === '场景视觉' ? 'changjing-shijue'
                          : name === '视频生成' ? 'shipin-shengcheng'
                          : name === '品牌与商业' ? 'pinpai-yu-shangye'
                          : name === '动画短片' ? 'donghua-duanpian'
                          : 'skill' },
  }));
}

const { category: slug } = Astro.params;
if (!slug) return Astro.redirect('/');
const category = categoryFromSlug(slug);

// Strip markdown syntax so the excerpt on category cards reads as plain
// prose instead of leaking `## headings`, `![image](url)`, `[link](url)`
// into the listing page. Keeps Chinese text, punctuation, and whitespace.
function plainExcerpt(md) {
  return md
    // Image syntax: drop entirely
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    // Link syntax: keep label
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    // Heading markers, blockquote, list bullets at line start
    .replace(/^[ \t]*(#{1,6}|>|\*|-|\d+\.)[ \t]+/gm, '')
    // Bold/italic markers
    .replace(/[*_`]+/g, '')
    // Collapse whitespace runs and strip leading/trailing
    .replace(/\s+/g, ' ')
    .trim();
}

const prompts = (await getCollection('prompts'))
  .filter(p => p.data.category === category)
  .sort((a, b) => (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0));
---
<BaseLayout title={`${category} · AI 提示词收藏`}>
  <h1>{category}</h1>
  <p>{prompts.length} 个 prompt</p>
  {prompts.map(p => (
    <PromptCard
      title={p.data.title}
      category={p.data.category}
      tags={p.data.tags}
      slug={p.data.slug}
      excerpt={plainExcerpt(p.body ?? '').slice(0, 120)}
      date={p.data.date}
    />
  ))}
</BaseLayout>